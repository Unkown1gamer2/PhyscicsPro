<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Multi Learn Player</title>
        <meta
            name="description"
            content="Interactive Multi Learn Player."
        />

        <!-- Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap"
            rel="stylesheet"
        />

        <!-- Tailwind CSS -->
        <script src="https://cdn.tailwindcss.com"></script>
        <script>
            tailwind.config = {
                darkMode: "class",
                theme: {
                    extend: {
                        colors: {
                            background: "hsl(var(--background))",
                            foreground: "hsl(var(--foreground))",
                            accent: "hsl(var(--accent))",
                            "accent-foreground":
                                "hsl(var(--accent-foreground))",
                            muted: "hsl(var(--muted))",
                            "muted-foreground": "hsl(var(--muted-foreground))",
                            border: "hsl(var(--border))",
                        },
                    },
                },
            };
        </script>

        <!-- Custom CSS -->
        <link rel="stylesheet" href="assets/css/style.css" />

        <!-- MathJax for LaTeX support -->
        <script>
        window.MathJax = {
          tex: {
            inlineMath: [['$', '$'], ['\\(', '\\)']]
          }
        };
        </script>
        <script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>
    </head>
    <body>
        <div class="min-h-screen bg-background">
            <!-- Back to Hub Button -->
            <div class="fixed top-6 left-6 z-50">
                <button
                    onclick="window.location.href='multi-learn-test-hub.html'"
                    class="glass-card px-4 py-2 rounded-lg hover:bg-muted/20 transition-all duration-200 flex items-center gap-2"
                >
                    <svg
                        class="w-4 h-4"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M15 19l-7-7 7-7"
                        ></path>
                    </svg>
                    <span>Back to Hub</span>
                </button>
            </div>

            <!-- Theme Toggle -->
            <div class="fixed top-6 right-6 z-50">
                <button
                    id="theme-toggle"
                    class="p-2 rounded-lg glass-card hover:bg-muted/20 transition-colors duration-200"
                >
                    <svg
                        class="w-5 h-5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"
                        ></path>
                    </svg>
                </button>
            </div>

            <!-- Content -->
            <div class="max-w-4xl mx-auto px-4 py-20">
                <!-- Header & Video -->
                <div class="text-center mb-12">
                    <h1
                        id="video-title"
                        class="text-4xl font-bold mb-4"
                    >
                        Loading...
                    </h1>
                    <div class="max-w-3xl mx-auto">
                        <iframe 
                            id="video-iframe"
                            width="560" 
                            height="315" 
                            src="" 
                            title="YouTube video player" 
                            frameborder="0" 
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                            allowfullscreen
                            class="w-full aspect-video rounded-lg shadow-lg"
                        ></iframe>
                    </div>
                </div>

                <!-- Questions Container -->
                <div id="questions-container" class="space-y-8">
                    <!-- Questions will be populated by JavaScript -->
                </div>

                <!-- Completion Message -->
                <div
                    id="completion-message"
                    class="hidden mt-8 text-center glass-card rounded-2xl p-8"
                >
                    <h3 class="text-2xl font-bold text-accent mb-4">
                        Lesson Complete! 🎉
                    </h3>
                    <p class="text-muted-foreground mb-6">
                        You've completed all questions for this topic.
                    </p>
                    <button
                        onclick="window.location.href='multi-learn-test-hub.html'"
                        class="bg-accent hover:bg-accent/90 text-accent-foreground px-8 py-3 rounded-lg font-semibold transition-all duration-300"
                    >
                        Back to Hub
                    </button>
                </div>
            </div>
        </div>

        <!-- JavaScript -->
        <script type="module" src="assets/js/script.js"></script>
        <script type="module" src="assets/js/multi-learn-test-player.js"></script>
    </body>
</html>
