{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "*": ["*", "*.js"]
    },
    "checkJs": true,
    "jsx": "preserve",
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "node",
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": ["**/*.js", "**/*.jsx", "**/*.json"],
  "exclude": ["node_modules"]
}